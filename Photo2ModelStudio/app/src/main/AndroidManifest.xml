<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Photo2Model"
        android:supportsRtl="true"
        android:extractNativeLibs="false">

        <activity
            android:name=".ui.ProjectListActivity"
            android:exported="true"
            android:theme="@style/Theme.Photo2Model">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ImportActivity"
            android:exported="false"
            android:label="@string/import_title" />

        <activity
            android:name=".ui.MaskEditorActivity"
            android:exported="false" />

        <activity
            android:name=".ui.LandmarkEditorActivity"
            android:exported="false" />

    </application>

</manifest>
